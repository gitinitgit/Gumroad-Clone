{
  "name": "gumroad-clone",
  "version": "1.0.0",
  "description": "A production-grade digital marketplace built with Node.js, Express, React, and Razorpay",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "seed": "npm run seed --workspace=server",
    "clean": "rimraf node_modules server/node_modules client/node_modules shared/node_modules",
    "lint": "concurrently \"npm run lint --workspace=server\" \"npm run lint --workspace=client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@clerk/react": "^6.4.5"
  }
}
